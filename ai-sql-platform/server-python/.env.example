DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testdb
DB_USER=postgres
DB_PASSWORD=postgres
DB_PROJECT_TABLE=projects
DB_PROJECT_ID_COL=project_id
DB_PROJECT_NAME_COL=project_name
DB_PROJECT_STATUS_COL=status
DB_PROJECT_START_DATE_COL=start_date
DB_PROJECT_END_DATE_COL=end_date
DB_PROJECT_GO_LIVE_COL=go_live_date

OPENAI_API_KEY=your_openai_api_key_here
# Optional fallbacks (comma/semicolon/newline separated). The server will try these in order.
# OPENAI_API_KEYS=key1,key2

# Optional: override speech-to-text model (server /api/speech/transcribe).
# If you hit model access errors, try: whisper-1
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Server port
PORT=8000

# ---------------------------------------------------------------------------
# n8n Automation integration (optional)
# ---------------------------------------------------------------------------
# Run n8n: docker run -p 5678:5678 n8nio/n8n
# Then: Settings → API → Enable Public API → copy key below
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key-here
# Shared secret – set the same value as the X-N8N-Secret header in your n8n webhook node
N8N_WEBHOOK_SECRET=your-random-secret-here
